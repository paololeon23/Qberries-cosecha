# Netlify → Site configuration → Environment variables
# Copie a .env local (no subir .env). Valores reales solo en Netlify.

# Contraseña de prueba (todos los supervisores). Producción: use SUPERVISOR_PINS.
LOGIN_PIN=231223
API_TOKEN=your_api_token_here

# Opcional: una clave por DNI (si existe, LOGIN_PIN deja de usarse como master).
# SUPERVISOR_PINS={"70839380":"clave-personal","12345678":"otra-clave"}

# Code.gs de Supervisores (vínculos) — URL …/exec
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Code-guias.gs — sin token.
# Opcional en Netlify: si no la pones, sync.js ya trae la URL fija de guías.
# APPS_SCRIPT_GUIAS_URL=https://script.google.com/macros/s/AKfycbxVryHDgOjOdiYRhFjBN1dxy6ozSzCwRMFKRW-6QM9h97Fraclys4ftTCM6Z9-vL5BX/exec
APPS_SCRIPT_GUIAS_URL=https://script.google.com/macros/s/AKfycbxVryHDgOjOdiYRhFjBN1dxy6ozSzCwRMFKRW-6QM9h97Fraclys4ftTCM6Z9-vL5BX/exec

# Local cloud API (solo pruebas con local-server.ps1)
# LOCAL_ALLOW_CLOUD=1
